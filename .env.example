# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public HTTPS URL where the frontend is hosted (Telegram WebApp URL).
APP_URL="https://your-public-frontend.example"

# Set when frontend and backend are hosted on separate domains.
VITE_SERVER_URL="https://your-public-backend.example"

# Production Supabase project (server-side only).
SUPABASE_URL="https://sqmicjzafgcymcfdjlai.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SET_FROM_SUPABASE_PROJECT_API_SETTINGS"

# Supabase Dashboard > Connect > Connection string (URI).
# The PostgreSQL connection is required for durable user wallets and game snapshots.
SUPABASE_DB_URL="postgresql://postgres:<database-password>@db.sqmicjzafgcymcfdjlai.supabase.co:5432/postgres?sslmode=require"

# Public interfaces for container/cloud deployments.
HOST="0.0.0.0"
PORT="8080"

# Disable bot polling during local development.
DISABLE_TELEGRAM_BOT=true

# Set a unique random secret (at least 32 characters) for signed worldwide guest gameplay sessions.
BINGO_GUEST_SECRET="GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
