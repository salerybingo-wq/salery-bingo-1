# Optional Gemini API key, consumed server-side only.
GEMINI_API_KEY="set-in-deployment-environment"

# Public HTTPS URL where the frontend is hosted (Telegram WebApp URL).
APP_URL="https://your-frontend.example"

# Set when frontend and backend are hosted on separate domains.
VITE_SERVER_URL="https://your-backend.example"

# Server-side Supabase project URL and secret service-role key.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="set-in-deployment-environment"

# Supabase Dashboard > Connect > PostgreSQL connection string.
SUPABASE_DB_URL="postgresql://postgres:<database-password>@<database-host>:5432/postgres?sslmode=require"

# Telegram Bot API token (never expose this in client-side configuration).
TELEGRAM_BOT_TOKEN="set-in-deployment-environment"

# Public interfaces for container/cloud deployments.
HOST="0.0.0.0"
PORT="8080"

# Disable bot polling during local development.
DISABLE_TELEGRAM_BOT=true

# Set a unique random secret (at least 32 characters) for signed worldwide guest gameplay sessions.
BINGO_GUEST_SECRET="GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
