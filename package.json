{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently --names client,server --prefix-colors cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "dev:server": "tsx server.ts",
    "build": "vite build && npx esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js && cp server.js server/index.js 2>/dev/null || true",
    "build:server": "npx esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server/index.js && cp server/index.js server.js 2>/dev/null || true",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-telegram-bot-api": "^2.1.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6"
  }
}
